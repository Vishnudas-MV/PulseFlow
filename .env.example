# ==============================================================================
# PulseFlow Enterprise Environment Configuration
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
SERVICE_NAME=pulseflow-api

# Security & CORS
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging & Observability
LOG_LEVEL=debug
LOG_PRETTY=true

# PostgreSQL 16 Primary Relational Store
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulseflow_db
POSTGRES_USER=pulseflow_admin
POSTGRES_PASSWORD=pulseflow_secret
POSTGRES_MAX_POOL_SIZE=20
DATABASE_URL=postgresql://pulseflow_admin:pulseflow_secret@localhost:5432/pulseflow_db?schema=public

# MongoDB 7 Document & Audit Store
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=pulseflow_audit
MONGO_USER=pulseflow_admin
MONGO_PASSWORD=pulseflow_secret
MONGO_URI=mongodb://pulseflow_admin:pulseflow_secret@localhost:27017/pulseflow_audit?authSource=admin

# Redis 7 In-Memory Cache, Idempotency & Queue Engine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pulseflow_redis_secret
REDIS_DB=0
REDIS_URL=redis://:pulseflow_redis_secret@localhost:6379/0
